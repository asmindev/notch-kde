import { IconButton } from "icon-button.slint";
import { Icons } from "../theme/icons.slint";

export component PlaybackControls inherits HorizontalLayout {
    in property <bool> is-playing: false;
    out property <bool> is-hovered: prev-btn.has-hover || play-btn.has-hover || next-btn.has-hover;
    
    callback play-pause();
    callback next();
    callback previous();

    alignment: center;
    spacing: 10px;
    height: 26px;

    VerticalLayout {
        alignment: center;
        prev-btn := IconButton {
            icon: Icons.skip-back;
            btn-size: 20px;
            icon-size: 10px;
            clicked => { root.previous(); }
        }
    }

    VerticalLayout {
        alignment: center;
        play-btn := IconButton {
            icon: root.is-playing ? Icons.pause : Icons.play;
            btn-size: 26px;
            icon-size: 13px;
            active: root.is-playing;
            clicked => { root.play-pause(); }
        }
    }

    VerticalLayout {
        alignment: center;
        next-btn := IconButton {
            icon: Icons.skip-forward;
            btn-size: 20px;
            icon-size: 10px;
            clicked => { root.next(); }
        }
    }
}
