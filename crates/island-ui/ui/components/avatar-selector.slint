import { ThemeColors } from "../theme/colors.slint";
import { ThemeTypography } from "../theme/typography.slint";
import { IslandContext } from "../context.slint";
import { PetView } from "pet-view.slint";

component AvatarChip inherits Rectangle {
    in property <string> glyph: "";
    in property <bool> active: false;
    in property <length> chip-size: 20px;
    out property <bool> has-hover <=> touch.has-hover;

    callback clicked();

    width: root.chip-size;
    height: root.chip-size;
    border-radius: root.chip-size / 2;
    background: root.active
        ? #3b82f633
        : (touch.has-hover ? #ffffff20 : #ffffff0e);
    border-width: 1px;
    border-color: root.active
        ? #3b82f6
        : (touch.has-hover ? #ffffff38 : #ffffff18);

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    Text {
        text: root.glyph;
        color: root.active ? ThemeColors.foreground : ThemeColors.muted;
        font-family: ThemeTypography.font-family;
        font-size: max(8px, root.chip-size * 0.46);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component AvatarSwatch inherits Rectangle {
    in property <color> swatch: transparent;
    in property <bool> active: false;
    in property <length> chip-size: 18px;
    out property <bool> has-hover <=> touch.has-hover;

    callback clicked();

    width: root.chip-size;
    height: root.chip-size;
    border-radius: root.chip-size / 2;
    background: root.swatch;
    border-width: root.active ? 2px : 1px;
    border-color: root.active
        ? ThemeColors.accent
        : (touch.has-hover ? #ffffffaa : #ffffff33);

    animate border-color { duration: 120ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component AvatarAction inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <length> action-height: 18px;
    out property <bool> has-hover <=> touch.has-hover;

    callback clicked();

    width: max(40px, label-text.preferred-width + 14px);
    height: root.action-height;
    border-radius: root.action-height / 2;
    background: root.active
        ? #3b82f633
        : (touch.has-hover ? #ffffff20 : #ffffff0e);
    border-width: 1px;
    border-color: root.active
        ? #3b82f6
        : (touch.has-hover ? #ffffff38 : #ffffff18);

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    label-text := Text {
        text: root.label;
        color: root.active ? ThemeColors.foreground : ThemeColors.muted;
        font-family: ThemeTypography.font-family;
        font-size: max(8px, root.action-height * 0.44);
        font-weight: ThemeTypography.weight-medium;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AvatarSelectorBar inherits HorizontalLayout {
    in property <length> bar-height: 22px;
    out property <bool> is-hovered: shape-chip.has-hover
        || palette-chip.has-hover
        || expression-chip.has-hover
        || shuffle-btn.has-hover
        || auto-btn.has-hover;

    alignment: center;
    spacing: 6px;
    height: root.bar-height;

    Text {
        text: "Bentuk";
        color: ThemeColors.muted;
        font-family: ThemeTypography.font-family;
        font-size: max(8px, root.bar-height * 0.4);
        vertical-alignment: center;
    }

    shape-chip := AvatarChip {
        glyph: IslandContext.avatar-shapes[IslandContext.blob-character].glyph;
        chip-size: root.bar-height;
        clicked => { IslandContext.cycle-blob-character(); }
    }

    Text {
        text: "Warna";
        color: ThemeColors.muted;
        font-family: ThemeTypography.font-family;
        font-size: max(8px, root.bar-height * 0.4);
        vertical-alignment: center;
    }

    palette-chip := AvatarSwatch {
        swatch: IslandContext.avatar-palettes[IslandContext.blob-palette].swatch;
        chip-size: root.bar-height;
        clicked => { IslandContext.cycle-blob-palette(); }
    }

    Text {
        text: "Mata";
        color: ThemeColors.muted;
        font-family: ThemeTypography.font-family;
        font-size: max(8px, root.bar-height * 0.4);
        vertical-alignment: center;
    }

    expression-chip := AvatarChip {
        glyph: IslandContext.avatar-expressions[IslandContext.blob-expression].glyph;
        chip-size: root.bar-height;
        clicked => { IslandContext.cycle-blob-expression(); }
    }

    shuffle-btn := AvatarAction {
        label: "Acak";
        action-height: root.bar-height;
        clicked => { IslandContext.randomize-avatar(); }
    }

    auto-btn := AvatarAction {
        label: IslandContext.avatar-random ? "Auto ✓" : "Auto";
        active: IslandContext.avatar-random;
        action-height: root.bar-height;
        clicked => { IslandContext.toggle-avatar-random(); }
    }
}

export component AvatarSelectorView inherits Rectangle {
    width: 100%;
    height: 100%;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 8px;
        alignment: center;

        // Selector controls on the left
        VerticalLayout {
            horizontal-stretch: 1;
            height: 100%;
            spacing: 2px;
            alignment: center;

            HorizontalLayout {
                height: 16px;
                alignment: start;
                spacing: 4px;

                Text {
                    text: "Avatar";
                    color: ThemeColors.foreground;
                    font-family: ThemeTypography.font-family;
                    font-size: 10px;
                    font-weight: ThemeTypography.weight-bold;
                    vertical-alignment: center;
                }

                Text {
                    text: IslandContext.avatar-expressions[IslandContext.blob-expression].label;
                    color: ThemeColors.muted;
                    font-family: ThemeTypography.font-family;
                    font-size: 8px;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                shuffle-btn := AvatarAction {
                    label: "Acak";
                    action-height: 16px;
                    clicked => { IslandContext.randomize-avatar(); }
                }

                auto-btn := AvatarAction {
                    label: IslandContext.avatar-random ? "Auto ✓" : "Auto";
                    active: IslandContext.avatar-random;
                    action-height: 16px;
                    clicked => { IslandContext.toggle-avatar-random(); }
                }
            }

            HorizontalLayout {
                height: 16px;
                alignment: start;
                spacing: 1px;

                Text {
                    text: "Bentuk";
                    width: 34px;
                    color: ThemeColors.muted;
                    font-family: ThemeTypography.font-family;
                    font-size: 8px;
                    vertical-alignment: center;
                }

                for shape in IslandContext.avatar-shapes: AvatarChip {
                    glyph: shape.glyph;
                    active: IslandContext.blob-character == shape.index;
                    chip-size: 15px;
                    clicked => { IslandContext.select-blob-character(shape.index); }
                }
            }

            HorizontalLayout {
                height: 16px;
                alignment: start;
                spacing: 1px;

                Text {
                    text: "Warna";
                    width: 34px;
                    color: ThemeColors.muted;
                    font-family: ThemeTypography.font-family;
                    font-size: 8px;
                    vertical-alignment: center;
                }

                for palette in IslandContext.avatar-palettes: AvatarSwatch {
                    swatch: palette.swatch;
                    active: IslandContext.blob-palette == palette.index;
                    chip-size: 13px;
                    clicked => { IslandContext.select-blob-palette(palette.index); }
                }
            }

            HorizontalLayout {
                height: 16px;
                alignment: start;
                spacing: 1px;

                Text {
                    text: "Mata";
                    width: 34px;
                    color: ThemeColors.muted;
                    font-family: ThemeTypography.font-family;
                    font-size: 8px;
                    vertical-alignment: center;
                }

                for expression in IslandContext.avatar-expressions: AvatarChip {
                    glyph: expression.glyph;
                    active: IslandContext.blob-expression == expression.index;
                    chip-size: 15px;
                    clicked => { IslandContext.select-blob-expression(expression.index); }
                }
            }
        }

        // Live avatar preview on the right
        Rectangle {
            width: 74px;
            height: 100%;
            border-radius: 12px;
            background: ThemeColors.surface;
            border-width: 1px;
            border-color: ThemeColors.border;

            VerticalLayout {
                width: 100%;
                height: 100%;
                alignment: center;
                spacing: 1px;

                PetView {
                    pet-size: 54px;
                }

                Text {
                    text: IslandContext.avatar-expressions[IslandContext.blob-expression].label;
                    color: ThemeColors.muted;
                    font-family: ThemeTypography.font-family;
                    font-size: 8px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
