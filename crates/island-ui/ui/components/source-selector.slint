import { ThemeColors } from "../theme/colors.slint";
import { ThemeTypography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { IslandContext } from "../context.slint";

export component SourceChip inherits Rectangle {
    in property <string> source-id: "";
    in property <string> source-name: "Player";
    in property <image> source-icon;
    in property <bool> has-icon: false;
    in property <bool> is-active: false;
    in property <bool> is-playing: false;
    in property <length> chip-height: 24px;
    out property <bool> has-hover <=> touch.has-hover;

    callback clicked();

    width: root.chip-height;
    height: root.chip-height;
    border-radius: root.chip-height * 0.28;
    background: root.is-active 
        ? #3b82f633 
        : (touch.has-hover ? #ffffff20 : #ffffff0e);
    border-width: 1px;
    border-color: root.is-active 
        ? #3b82f6 
        : (touch.has-hover ? #ffffff38 : #ffffff18);

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    // App Icon (or fallback music icon)
    if root.has-icon: Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.chip-height * 0.68;
        height: root.chip-height * 0.68;
        source: root.source-icon;
        image-fit: contain;
    }

    if !root.has-icon: Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.chip-height * 0.62;
        height: root.chip-height * 0.62;
        source: Icons.music;
        colorize: root.is-active ? ThemeColors.accent : ThemeColors.foreground;
        image-fit: contain;
    }

    // Playing status dot indicator (Green dot in top-right corner if currently playing)
    if root.is-playing: Rectangle {
        x: parent.width - self.width - 1.5px;
        y: 1.5px;
        width: 5px;
        height: 5px;
        border-radius: 2.5px;
        background: ThemeColors.success;
        border-width: 1px;
        border-color: #000000aa;
    }
}

export component SourceSelectorBar inherits HorizontalLayout {
    in property <length> bar-height: 24px;
    out property <bool> is-hovered: false;

    alignment: start;
    spacing: 6px;
    height: root.bar-height;

    for source in IslandContext.player-sources: SourceChip {
        source-id: source.id;
        source-name: source.name;
        source-icon: source.icon;
        has-icon: source.has-icon;
        is-active: source.is-active;
        is-playing: source.is-playing;
        chip-height: root.bar-height;
        clicked => {
            IslandContext.select-player-source(source.id);
        }
    }

    if IslandContext.player-sources.length == 0: Text {
        text: "No active media players";
        color: ThemeColors.muted;
        font-family: ThemeTypography.font-family;
        font-size: max(9px, min(12px, root.bar-height * 0.5));
        font-italic: true;
        vertical-alignment: center;
    }
}
