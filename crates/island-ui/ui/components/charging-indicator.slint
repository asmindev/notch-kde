import { ThemeColors } from "../theme/colors.slint";
import { ThemeTypography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { IslandContext } from "../context.slint";

export component ChargingIndicator inherits HorizontalLayout {
    in property <bool> active: true;
    in property <int> percentage: 85;
    in property <bool> is-charging: false;
    in property <bool> compact: false;

    private property <float> progress: min(0.9999, max(0.0, root.percentage / 100.0));
    private property <bool> pulse: true;

    pulse-timer := Timer {
        interval: 900ms;
        running: root.active && IslandContext.render-animations && root.is-charging;
        triggered => { root.pulse = !root.pulse; }
    }

    alignment: center;
    spacing: 6px;

    if root.is-charging: Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        border-width: 1.5px;
        border-color: #3f3f46;
        background: #1c1c20;

        Rectangle {
            x: -1px;
            y: -1px;
            width: parent.width + 2px;
            height: parent.height + 2px;
            border-radius: self.width / 2;
            background: #22c55e;
            opacity: root.pulse ? 0.20 : 0.06;
            animate opacity { duration: 750ms; easing: ease-in-out; }
        }

        Path {
            width: 20px;
            height: 20px;
            viewbox-width: 100;
            viewbox-height: 100;
            fill: transparent;
            stroke: ThemeColors.success;
            stroke-width: 1.5px;
            opacity: root.pulse ? 1.0 : 0.55;
            animate opacity { duration: 750ms; easing: ease-in-out; }

            MoveTo {
                x: 50;
                y: 5;
            }

            ArcTo {
                radius-x: 45;
                radius-y: 45;
                x: 50 + 45 * sin(root.progress * 360deg);
                y: 50 - 45 * cos(root.progress * 360deg);
                sweep: root.progress > 0;
                large-arc: root.progress > 0.5;
            }
        }

        Image {
            width: 10px;
            height: 10px;
            source: Icons.zap;
            image-fit: contain;
            colorize: ThemeColors.success;
        }
    }

    if !root.is-charging: Image {
        width: 14px;
        height: 14px;
        source: Icons.zap;
        image-fit: contain;
        colorize: ThemeColors.muted;
    }

    // Percentage number: strictly hidden in compact mode!
    if !root.compact: Text {
        text: "\{root.percentage}%";
        color: root.is-charging ? ThemeColors.success : ThemeColors.muted;
        font-family: ThemeTypography.font-family;
        font-size: ThemeTypography.size-sm;
        font-weight: ThemeTypography.weight-bold;
        vertical-alignment: center;
    }
}
