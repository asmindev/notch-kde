import { ThemeColors } from "../theme/colors.slint";

component CavaBar inherits Rectangle {
    in property <float> val: 0.0;
    in property <length> max-h: 14px;

    width: 2.5px;
    height: max(2px, root.val * root.max-h);
    background: root.val > 0.9 ? ThemeColors.apple-red :
        (root.val >= 0.5 ? ThemeColors.accent : ThemeColors.muted);
    border-radius: 1px;
    y: (root.max-h - self.height) / 2;

    animate background { duration: 60ms; }
}

export component CavaVisualizer inherits HorizontalLayout {
    in property <float> b0: 0.2;
    in property <float> b1: 0.5;
    in property <float> b2: 0.8;
    in property <float> b3: 0.6;
    in property <float> b4: 0.9;
    in property <float> b5: 0.4;
    in property <float> b6: 0.3;
    in property <float> b7: 0.1;
    in property <length> viz-height: 14px;

    spacing: 2px;
    alignment: center;
    height: root.viz-height;

    CavaBar { val: root.b0; max-h: root.viz-height; }
    CavaBar { val: root.b1; max-h: root.viz-height; }
    CavaBar { val: root.b2; max-h: root.viz-height; }
    CavaBar { val: root.b3; max-h: root.viz-height; }
    CavaBar { val: root.b4; max-h: root.viz-height; }
    CavaBar { val: root.b5; max-h: root.viz-height; }
    CavaBar { val: root.b6; max-h: root.viz-height; }
    CavaBar { val: root.b7; max-h: root.viz-height; }
}
