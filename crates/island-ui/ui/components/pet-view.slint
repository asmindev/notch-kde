import { IslandContext } from "../context.slint";
import { FloatingNotes } from "floating-notes.slint";
import { BlobatarPet } from "blobatar-pet.slint";

export component PetView inherits Rectangle {
    in property <length> pet-size: 24px;
    out property <bool> is-hovered <=> touch.has-hover;

    width: root.pet-size;
    height: root.pet-size;
    background: transparent;

    property <bool> is-singing: IslandContext.is-playing && IslandContext.music-reactions-enabled;
    property <bool> is-happy: IslandContext.pet-is-happy || IslandContext.is-welcome;

    // ==========================================
    // 1. BLOUB 3D PET (WGPU) + VECTOR FALLBACK
    // ==========================================
    if IslandContext.pet-3d-ready : Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.pet-size;
        height: root.pet-size;
        source: IslandContext.pet-3d-image;
        image-fit: contain;
    }

    if !IslandContext.pet-3d-ready : BlobatarPet {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        pet-size: root.pet-size;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            IslandContext.mochi-clicked();
            IslandContext.pet-clicked();
        }
    }

    // ==========================================
    // 2. FLOATING MUSICAL NOTES & PARTICLES
    // ==========================================
    notes := FloatingNotes {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 4px;
        is-singing: root.is-singing;
        is-happy: root.is-happy;
        pet-size: root.pet-size;
    }
}
