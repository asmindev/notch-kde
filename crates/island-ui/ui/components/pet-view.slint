import { IslandContext } from "../context.slint";
import { FloatingNotes } from "floating-notes.slint";

export component PetView inherits Rectangle {
    in property <length> pet-size: 24px;
    out property <bool> is-hovered <=> touch.has-hover;

    width: root.pet-size;
    height: root.pet-size;
    background: transparent;

    property <float> bass: (IslandContext.b0 + IslandContext.b1) * 0.5;
    property <float> mid: (IslandContext.b2 + IslandContext.b3) * 0.5;

    property <bool> is-singing: IslandContext.is-playing;
    property <bool> is-happy: IslandContext.pet-is-happy;
    property <bool> is-hovered-state: touch.has-hover;

    // Audio-reactive bounce offset
    property <length> bounce-y: root.is-happy 
        ? -6px 
        : (root.is-singing ? -(root.bass * 5px) : 0px);

    // Audio-reactive squash and stretch scale
    property <float> scale-y: root.is-happy 
        ? 1.14 
        : (root.is-singing ? (1.0 + (root.bass * 0.12)) : (root.is-hovered-state ? 1.06 : 1.0));

    property <float> scale-x: root.is-happy 
        ? 0.92 
        : (root.is-singing ? (1.0 - (root.bass * 0.06)) : (root.is-hovered-state ? 1.06 : 1.0));

    // ==========================================
    // 1. SOFT GLOW AURA (Behind Labubu)
    // ==========================================
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + root.bounce-y;
        width: root.pet-size * 1.15;
        height: root.pet-size * 1.15;
        border-radius: self.width / 2;
        background: root.is-happy 
            ? #f472b622 
            : (root.is-singing ? #60a5fa20 : (root.is-hovered-state ? #ffffff15 : transparent));

        animate background { duration: 180ms; }
    }

    // ==========================================
    // 2. 3D LABUBU CHARACTER (Multi-State Sprites)
    // ==========================================
    char-container := Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.bounce-y;
        width: root.pet-size * root.scale-x;
        height: root.pet-size * root.scale-y;

        animate y { duration: 60ms; easing: ease-out; }
        animate width { duration: 60ms; easing: ease-out; }
        animate height { duration: 60ms; easing: ease-out; }

        // State 0: Idle Pose (Default sweet toothy grin)
        Image {
            width: 100%;
            height: 100%;
            source: @image-url("../../assets/pet/labubu_idle.png");
            image-fit: contain;
            opacity: (!root.is-singing && !root.is-happy) ? 1.0 : 0.0;
            visible: self.opacity > 0.01;

            animate opacity { duration: 160ms; easing: ease-out; }
        }

        // State 1: Singing Pose (With cute headphones & singing mouth)
        Image {
            width: 100%;
            height: 100%;
            source: @image-url("../../assets/pet/labubu_singing.png");
            image-fit: contain;
            opacity: (root.is-singing && !root.is-happy) ? 1.0 : 0.0;
            visible: self.opacity > 0.01;

            animate opacity { duration: 160ms; easing: ease-out; }
        }

        // State 2: Happy Petting Pose (Blushing cheeks & jump)
        Image {
            width: 100%;
            height: 100%;
            source: @image-url("../../assets/pet/labubu_happy.png");
            image-fit: contain;
            opacity: root.is-happy ? 1.0 : 0.0;
            visible: self.opacity > 0.01;

            animate opacity { duration: 140ms; easing: ease-out; }
        }
    }

    // ==========================================
    // 3. FLOATING MUSICAL NOTES & PARTICLES
    // ==========================================
    notes := FloatingNotes {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 4px;
        is-singing: root.is-singing;
        is-happy: root.is-happy;
        pet-size: root.pet-size;
    }

    // ==========================================
    // 4. INTERACTIVE TOUCH TARGET (Petting / Click)
    // ==========================================
    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            IslandContext.pet-clicked();
        }
    }
}
