import { IslandContext } from "../context.slint";
import { FloatingNotes } from "floating-notes.slint";
import { MomoProceduralPet } from "momo-procedural-pet.slint";

export component PetView inherits Rectangle {
    in property <length> pet-size: 24px;
    out property <bool> is-hovered <=> touch.has-hover;

    width: root.pet-size;
    height: root.pet-size;
    background: transparent;

    property <bool> is-singing: IslandContext.is-playing;
    property <bool> is-happy: IslandContext.pet-is-happy || IslandContext.is-welcome;
    property <bool> is-dizzy: IslandContext.pet-is-dizzy;
    property <bool> is-sleepy: IslandContext.pet-is-sleepy;

    // ==========================================
    // 1. MOMO PROCEDURAL CODE-DRAWN PET (Zero image assets)
    // ==========================================
    momo := MomoProceduralPet {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        pet-size: root.pet-size;
        is-singing: root.is-singing;
        is-happy: root.is-happy;
        is-dizzy: root.is-dizzy;
        is-sleepy: root.is-sleepy;
    }

    // ==========================================
    // 2. FLOATING MUSICAL NOTES & PARTICLES
    // ==========================================
    notes := FloatingNotes {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 4px;
        is-singing: root.is-singing;
        is-happy: root.is-happy;
        pet-size: root.pet-size;
    }

    // ==========================================
    // 3. INTERACTIVE TOUCH TARGET (Petting / Click)
    // ==========================================
    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            IslandContext.pet-clicked();
        }
    }
}
