import { ThemeColors } from "../theme/colors.slint";
import { ThemeMetrics } from "../theme/metrics.slint";
import { Icons } from "../theme/icons.slint";
import { IslandContext } from "../context.slint";
import { IconButton } from "icon-button.slint";

export component BottomBar inherits VerticalLayout {
    in property <length> btn-dim: 22px;
    out property <bool> is-hovered: music-btn.has-hover || mute-btn.has-hover || dnd-btn.has-hover
        || prayer-btn.has-hover || settings-btn.has-hover;

    alignment: center;
    spacing: 3px;

    // Horizontal Gray Divider Line
    Rectangle {
        width: 100%;
        height: 1px;
        background: #3f3f46;
        opacity: 0.8;
    }

    // Action Buttons Row (System controls + Settings)
    HorizontalLayout {
        alignment: center;
        spacing: max(10px, min(16px, root.btn-dim * 0.62));
        height: root.btn-dim;

        HorizontalLayout {
            alignment: center;
            spacing: max(8px, min(14px, root.btn-dim * 0.58));

            // Music Source Toggle Button
            VerticalLayout {
                alignment: center;
                music-btn := IconButton {
                    icon: Icons.music;
                    btn-size: root.btn-dim;
                    icon-size: root.btn-dim * 0.52;
                    active: IslandContext.show-source-selector;
                    clicked => { IslandContext.toggle-source-selector(); }
                }
            }

            // Mute Toggle Button
            VerticalLayout {
                alignment: center;
                mute-btn := IconButton {
                    icon: IslandContext.is-muted ? Icons.volume-x : Icons.volume-2;
                    btn-size: root.btn-dim;
                    icon-size: root.btn-dim * 0.52;
                    active: IslandContext.is-muted;
                    clicked => { IslandContext.toggle-mute(); }
                }
            }

            // DND Toggle Button
            VerticalLayout {
                alignment: center;
                dnd-btn := IconButton {
                    icon: IslandContext.is-dnd ? Icons.bell-off : Icons.bell;
                    btn-size: root.btn-dim;
                    icon-size: root.btn-dim * 0.52;
                    active: IslandContext.is-dnd;
                    clicked => { IslandContext.toggle-dnd(); }
                }
            }
        }

        Rectangle {
            width: 1px;
            height: root.btn-dim * 0.62;
            background: ThemeColors.divider;
        }

        prayer-btn := IconButton {
            icon: Icons.moon;
            btn-size: root.btn-dim;
            icon-size: root.btn-dim * 0.52;
            active: IslandContext.prayer-panel-open;
            clicked => { IslandContext.toggle-prayer-panel(); }
        }

        settings-btn := IconButton {
            icon: Icons.settings;
            btn-size: root.btn-dim;
            icon-size: root.btn-dim * 0.52;
            active: IslandContext.settings-open;
            clicked => { IslandContext.open-settings(); }
        }
    }
}
