import { ThemeColors } from "../theme/colors.slint";
import { ThemeMetrics } from "../theme/metrics.slint";
import { Icons } from "../theme/icons.slint";
import { IslandContext } from "../context.slint";
import { IconButton } from "icon-button.slint";

component AvatarButton inherits Rectangle {
    in property <string> glyph: "";
    in property <color> swatch: transparent;
    in property <bool> swatch-only: false;
    in property <bool> show-swatch-dot: false;
    in property <bool> active: false;
    in property <length> btn-size: 22px;
    out property <bool> has-hover <=> touch.has-hover;

    callback clicked();

    width: root.btn-size;
    height: root.btn-size;
    border-radius: root.btn-size / 2;
    background: touch.has-hover
        ? ThemeColors.surface-hover
        : (root.active ? ThemeColors.surface-hover : ThemeColors.surface);
    border-width: 1px;
    border-color: root.active ? ThemeColors.accent : ThemeColors.border;
    animate background { duration: ThemeMetrics.fast-anim; }

    if !root.swatch-only: Text {
        text: root.glyph;
        color: ThemeColors.foreground;
        font-size: max(8px, root.btn-size * 0.44);
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.swatch-only: Rectangle {
        width: root.btn-size * 0.62;
        height: root.btn-size * 0.62;
        border-radius: root.btn-size * 0.31;
        background: root.swatch;
        border-width: 1px;
        border-color: #ffffff33;
    }

    if root.show-swatch-dot: Rectangle {
        x: parent.width - root.btn-size * 0.36;
        y: parent.height - root.btn-size * 0.36;
        width: root.btn-size * 0.32;
        height: root.btn-size * 0.32;
        border-radius: root.btn-size * 0.16;
        background: root.swatch;
        border-width: 1px;
        border-color: #ffffff55;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }
}

export component BottomBar inherits VerticalLayout {
    in property <length> btn-dim: 22px;
    out property <bool> is-hovered: music-btn.has-hover || mute-btn.has-hover || dnd-btn.has-hover
        || avatar-btn.has-hover;

    alignment: center;
    spacing: 3px;

    // Horizontal Gray Divider Line
    Rectangle {
        width: 100%;
        height: 1px;
        background: #3f3f46;
        opacity: 0.8;
    }

    // Action Buttons Row (System controls + Avatar picker)
    HorizontalLayout {
        alignment: center;
        spacing: max(10px, min(16px, root.btn-dim * 0.62));
        height: root.btn-dim;

        HorizontalLayout {
            alignment: center;
            spacing: max(8px, min(14px, root.btn-dim * 0.58));

            // Music Source Toggle Button
            VerticalLayout {
                alignment: center;
                music-btn := IconButton {
                    icon: Icons.music;
                    btn-size: root.btn-dim;
                    icon-size: root.btn-dim * 0.52;
                    active: IslandContext.show-source-selector;
                    clicked => { IslandContext.toggle-source-selector(); }
                }
            }

            // Mute Toggle Button
            VerticalLayout {
                alignment: center;
                mute-btn := IconButton {
                    icon: IslandContext.is-muted ? Icons.volume-x : Icons.volume-2;
                    btn-size: root.btn-dim;
                    icon-size: root.btn-dim * 0.52;
                    active: IslandContext.is-muted;
                    clicked => { IslandContext.toggle-mute(); }
                }
            }

            // DND Toggle Button
            VerticalLayout {
                alignment: center;
                dnd-btn := IconButton {
                    icon: IslandContext.is-dnd ? Icons.bell-off : Icons.bell;
                    btn-size: root.btn-dim;
                    icon-size: root.btn-dim * 0.52;
                    active: IslandContext.is-dnd;
                    clicked => { IslandContext.toggle-dnd(); }
                }
            }
        }

        Rectangle {
            width: 1px;
            height: root.btn-dim * 0.62;
            background: ThemeColors.divider;
        }

        // Avatar picker opens its own view instead of crowding the bottom bar.
        avatar-btn := AvatarButton {
            glyph: IslandContext.avatar-shapes[IslandContext.blob-character].glyph;
            swatch: IslandContext.avatar-palettes[IslandContext.blob-palette].swatch;
            show-swatch-dot: true;
            active: IslandContext.show-avatar-selector;
            btn-size: root.btn-dim;
            clicked => { IslandContext.toggle-avatar-selector(); }
        }
    }
}
