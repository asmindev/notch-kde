export global ThemeColors {
    // Solid background, strictly without blur or gradient as specified in blueprint
    in-out property <color> background: #0b0b0e;
    in-out property <color> surface: #18181b;
    in-out property <color> surface-hover: #27272a;
    
    in-out property <color> foreground: #ffffff;
    in-out property <color> muted: #a1a1aa;
    in-out property <color> subtle: #71717a;
    
    in-out property <color> accent: #5aa2ff;
    in-out property <color> apple-red: #ff3b30;
    in-out property <color> success: #22c55e;
    in-out property <color> warning: #f59e0b;
    in-out property <color> error: #ef4444;
    
    in-out property <color> border: #27272a;
    in-out property <color> divider: #1f1f23;
}
