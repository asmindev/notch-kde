export global ThemeTypography {
    in-out property <string> font-family: "Noto Sans, Inter, sans-serif";
    
    in-out property <length> size-xs: 10px;
    in-out property <length> size-sm: 12px;
    in-out property <length> size-base: 13px;
    in-out property <length> size-lg: 15px;
    in-out property <length> size-xl: 18px;
    
    in-out property <int> weight-normal: 400;
    in-out property <int> weight-medium: 500;
    in-out property <int> weight-bold: 700;
}
