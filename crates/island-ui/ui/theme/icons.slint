export global ThemeIcons {
    // Media & Playback Controls
    in-out property <image> play: @image-url("../../assets/icons/play.svg");
    in-out property <image> pause: @image-url("../../assets/icons/pause.svg");
    in-out property <image> skip-back: @image-url("../../assets/icons/skip-back.svg");
    in-out property <image> skip-forward: @image-url("../../assets/icons/skip-forward.svg");
    in-out property <image> music: @image-url("../../assets/icons/music.svg");

    // System Quick Toggles (Audio & DND)
    in-out property <image> volume-x: @image-url("../../assets/icons/volume-x.svg");
    in-out property <image> volume-2: @image-url("../../assets/icons/volume-2.svg");
    in-out property <image> bell-off: @image-url("../../assets/icons/bell-off.svg");
    in-out property <image> bell: @image-url("../../assets/icons/bell.svg");

    // Navigation & Status Indicators
    in-out property <image> chevron-down: @image-url("../../assets/icons/chevron-down.svg");
    in-out property <image> zap: @image-url("../../assets/icons/zap.svg");
    in-out property <image> settings: @image-url("../../assets/icons/settings.svg");
}

export { ThemeIcons as Icons }
