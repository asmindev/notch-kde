import { ThemeMetrics } from "../theme/metrics.slint";
import { IslandContext } from "../context.slint";
import { SystemWideSlot } from "../modules/system/system-wide-slot.slint";
import { MediaWideSlot } from "../modules/media/media-wide-slot.slint";
import { AlertWideSlot } from "../modules/alert/alert-wide-slot.slint";
import { BottomBar } from "../components/bottom-bar.slint";

export component WideView inherits VerticalLayout {
    out property <bool> is-hovered: bottom-bar.is-hovered
        || (IslandContext.active-module == 1 && media-slot.is-hovered) 
        || (IslandContext.active-module == 0 && system-slot.is-hovered);

    width: 100%;
    height: 100%;
    spacing: 0px;
    padding: 0px;

    // 1. Primary Wide Content Container (Strictly 100% proportional to ThemeMetrics.wide-height)
    Rectangle {
        width: 100%;
        height: ThemeMetrics.wide-height;

        // Slot 0: System Module Wide Slot
        system-slot := SystemWideSlot {
            visible: IslandContext.active-module == 0;
            opacity: IslandContext.active-module == 0 ? 1.0 : 0.0;
        }

        // Slot 1: Media Module Wide Slot (Dynamic Studio)
        media-slot := MediaWideSlot {
            visible: IslandContext.active-module == 1;
            opacity: IslandContext.active-module == 1 ? 1.0 : 0.0;
        }

        // Slot 2: Alert Module Wide Slot
        alert-slot := AlertWideSlot {
            visible: IslandContext.active-module == 2;
            opacity: IslandContext.active-module == 2 ? 1.0 : 0.0;
        }
    }

    // 2. Bottom Bar Extension (Extends at bottom, does not occupy wide container)
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        height: ThemeMetrics.bottom-bar-height;

        bottom-bar := BottomBar {
            width: 100%;
            height: 100%;
        }
    }
}
