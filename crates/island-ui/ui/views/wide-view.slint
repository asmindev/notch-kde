import { ThemeMetrics } from "../theme/metrics.slint";
import { ThemeColors } from "../theme/colors.slint";
import { ThemeTypography } from "../theme/typography.slint";
import { IslandContext } from "../context.slint";
import { SystemWideSlot } from "../modules/system/system-wide-slot.slint";
import { MediaWideSlot } from "../modules/media/media-wide-slot.slint";
import { AlertWideSlot } from "../modules/alert/alert-wide-slot.slint";
import { WelcomeWideSlot } from "../modules/welcome/welcome-wide-slot.slint";
import { BottomBar } from "../components/bottom-bar.slint";
import { SourceSelectorBar } from "../components/source-selector.slint";

export component WideView inherits VerticalLayout {
    out property <bool> is-hovered: (!IslandContext.is-welcome && bottom-bar.is-hovered)
        || IslandContext.show-source-selector
        || (IslandContext.active-module == 1 && media-slot.is-hovered) 
        || (IslandContext.active-module == 0 && system-slot.is-hovered);

    width: 100%;
    height: 100%;
    spacing: 0px;
    padding: 0px;

    // 1. Primary Wide Content Container (Strictly 100% proportional to ThemeMetrics.wide-height or ThemeMetrics.welcome-height)
    Rectangle {
        width: 100%;
        height: IslandContext.is-welcome ? ThemeMetrics.welcome-height : ThemeMetrics.wide-height;

        // Slot -1: Welcome Greeting Slot (Option 1 - Labubu Greeting)
        if IslandContext.is-welcome: WelcomeWideSlot {
            width: 100%;
            height: 100%;
        }

        // Slot: Source Selector View in Wide Mode
        if !IslandContext.is-welcome && IslandContext.show-source-selector: Rectangle {
            width: 100%;
            height: 100%;

            HorizontalLayout {
                alignment: center;
                spacing: 10px;

                Text {
                    text: "Play from:";
                    color: ThemeColors.muted;
                    font-family: ThemeTypography.font-family;
                    font-size: max(10px, min(13px, ThemeMetrics.wide-height * 0.28));
                    font-weight: ThemeTypography.weight-medium;
                    vertical-alignment: center;
                }

                SourceSelectorBar {
                    bar-height: max(20px, min(26px, ThemeMetrics.wide-height * 0.58));
                }
            }
        }

        // Slot 0: System Module Wide Slot
        system-slot := SystemWideSlot {
            visible: !IslandContext.is-welcome && !IslandContext.show-source-selector && IslandContext.active-module == 0;
            opacity: (!IslandContext.is-welcome && !IslandContext.show-source-selector && IslandContext.active-module == 0) ? 1.0 : 0.0;
        }

        // Slot 1: Media Module Wide Slot (Dynamic Studio)
        media-slot := MediaWideSlot {
            visible: !IslandContext.is-welcome && !IslandContext.show-source-selector && IslandContext.active-module == 1;
            opacity: (!IslandContext.is-welcome && !IslandContext.show-source-selector && IslandContext.active-module == 1) ? 1.0 : 0.0;
        }

        // Slot 2: Alert Module Wide Slot
        alert-slot := AlertWideSlot {
            visible: !IslandContext.is-welcome && !IslandContext.show-source-selector && IslandContext.active-module == 2;
            opacity: (!IslandContext.is-welcome && !IslandContext.show-source-selector && IslandContext.active-module == 2) ? 1.0 : 0.0;
        }
    }

    // 2. Bottom Bar Extension (Hidden during Welcome Greeting for clean floating pill)
    HorizontalLayout {
        padding-left: max(12px, min(24px, root.width * 0.04));
        padding-right: max(12px, min(24px, root.width * 0.04));
        height: !IslandContext.is-welcome ? ThemeMetrics.bottom-bar-height : 0px;
        visible: !IslandContext.is-welcome;
        opacity: !IslandContext.is-welcome ? 1.0 : 0.0;

        bottom-bar := BottomBar {
            width: 100%;
            height: 100%;
            btn-dim: max(18px, min(24px, ThemeMetrics.bottom-bar-height * 0.75));
        }
    }
}
