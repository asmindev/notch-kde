import { ThemeColors } from "../theme/colors.slint";
import { ThemeMetrics } from "../theme/metrics.slint";
import { ThemeTypography } from "../theme/typography.slint";
import { Icons } from "../theme/icons.slint";
import { IslandContext } from "../context.slint";
import { IconButton } from "../components/icon-button.slint";
import { BottomBar } from "../components/bottom-bar.slint";
import { SourceSelectorBar } from "../components/source-selector.slint";
import { SystemExpandSlot } from "../modules/system/system-expand-slot.slint";
import { MediaExpandSlot } from "../modules/media/media-expand-slot.slint";

export component ExpandView inherits VerticalLayout {
    property <bool> show-source: IslandContext.show-source-selector && IslandContext.active-module == 1;
    property <bool> show-system: IslandContext.active-module == 0
        || (IslandContext.active-module == 1 && !IslandContext.is-playing && !root.show-source);
    property <bool> show-media: IslandContext.active-module == 1
        && (IslandContext.is-playing || root.show-source);

    out property <bool> is-hovered: collapse-btn.has-hover 
        || bottom-bar.is-hovered
        || (root.show-media && media-slot.is-hovered)
        || (root.show-system && system-slot.is-hovered);

    width: 100%;
    height: 100%;
    spacing: 0px;
    padding: 0px;

    // 1. Primary Expand Content Container
    property <length> content-h: ThemeMetrics.expand-height;
    property <length> hdr-h: max(18px, min(26px, root.content-h * 0.18));

    VerticalLayout {
        width: 100%;
        height: root.content-h;
        padding-left: max(14px, min(24px, root.width * 0.04));
        padding-right: max(14px, min(24px, root.width * 0.04));
        padding-top: max(6px, min(12px, root.content-h * 0.06));
        padding-bottom: max(6px, min(12px, root.content-h * 0.06));
        spacing: max(4px, min(10px, root.content-h * 0.05));

        // ==========================================
        // TEMPLATE HEADER (Shared by all modules)
        // ==========================================
        HorizontalLayout {
            alignment: space-between;
            height: root.hdr-h;

            HorizontalLayout {
                alignment: start;
                spacing: 8px;

                Image {
                    width: root.hdr-h * 0.6;
                    height: root.hdr-h * 0.6;
                    source: root.show-media ? Icons.music : Icons.zap;
                    image-fit: contain;
                    y: (parent.height - self.height) / 2;
                }

                if root.show-source: SourceSelectorBar {
                    bar-height: root.hdr-h;
                }

                if !root.show-source: Text {
                    text: root.show-media ? "Now Playing" : "System Overview";
                    color: ThemeColors.muted;
                    font-family: ThemeTypography.font-family;
                    font-size: ThemeTypography.size-xs;
                    font-weight: ThemeTypography.weight-medium;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                collapse-btn := IconButton {
                    icon: Icons.chevron-down;
                    btn-size: root.hdr-h * 0.9;
                    icon-size: root.hdr-h * 0.5;
                    clicked => { IslandContext.collapse-clicked(); }
                }
            }
        }

        // ==========================================
        // TEMPLATE BODY SLOT (Dynamic Module Content)
        // ==========================================
        Rectangle {
            width: 100%;
            vertical-stretch: 1;

            // Slot 0: System Module Expand Slot
            system-slot := SystemExpandSlot {
                visible: root.show-system;
                opacity: root.show-system ? 1.0 : 0.0;
            }

            // Slot 1: Media Module Expand Slot
            media-slot := MediaExpandSlot {
                visible: root.show-media;
                opacity: root.show-media ? 1.0 : 0.0;
            }
        }
    }

    // 2. Bottom Bar Extension (Extends at bottom, does not occupy expand container)
    HorizontalLayout {
        padding-left: max(14px, min(24px, root.width * 0.04));
        padding-right: max(14px, min(24px, root.width * 0.04));
        height: ThemeMetrics.bottom-bar-height;

        bottom-bar := BottomBar {
            width: 100%;
            height: 100%;
            btn-dim: max(18px, min(24px, ThemeMetrics.bottom-bar-height * 0.75));
        }
    }
}
