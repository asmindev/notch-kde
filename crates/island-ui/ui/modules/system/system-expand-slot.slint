import { ThemeColors } from "../../theme/colors.slint";
import { ThemeMetrics } from "../../theme/metrics.slint";
import { ThemeTypography } from "../../theme/typography.slint";
import { IslandContext } from "../../context.slint";
import { PetView } from "../../components/pet-view.slint";
import { ChargingIndicator } from "../../components/charging-indicator.slint";

export component SystemExpandSlot inherits VerticalLayout {
    out property <bool> is-hovered: false;

    property <length> slot-h: max(40px, ThemeMetrics.expand-height - 44px);

    width: 100%;
    height: 100%;
    spacing: max(4px, min(10px, root.slot-h * 0.08));

    // Large Clock + Date + Pet
    HorizontalLayout {
        alignment: space-between;
        height: root.slot-h * 0.58;

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: IslandContext.time-str;
                color: ThemeColors.foreground;
                font-family: ThemeTypography.font-family;
                font-size: max(14px, min(24px, root.slot-h * 0.35));
                font-weight: ThemeTypography.weight-bold;
            }

            Text {
                text: IslandContext.date-str;
                color: ThemeColors.muted;
                font-family: ThemeTypography.font-family;
                font-size: max(9px, min(13px, root.slot-h * 0.2));
            }
        }

        VerticalLayout {
            alignment: center;
            PetView {
                pet-size: max(26px, min(52px, root.slot-h * 0.52));
            }
        }
    }

    // Battery Status Bar
    HorizontalLayout {
        alignment: space-between;
        height: root.slot-h * 0.35;

        VerticalLayout {
            alignment: center;
            ChargingIndicator {
                percentage: IslandContext.battery-percentage;
                is-charging: IslandContext.is-charging;
                compact: false;
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: IslandContext.is-charging ? "Charging" : (IslandContext.battery-percentage > 20 ? "Battery Normal" : "Battery Low");
                color: IslandContext.is-charging ? #22c55e : ThemeColors.muted;
                font-family: ThemeTypography.font-family;
                font-size: max(9px, min(13px, root.slot-h * 0.22));
                font-weight: ThemeTypography.weight-medium;
            }
        }
    }
}
