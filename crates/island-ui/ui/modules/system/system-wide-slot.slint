import { ThemeColors } from "../../theme/colors.slint";
import { ThemeMetrics } from "../../theme/metrics.slint";
import { IslandContext } from "../../context.slint";
import { PetView } from "../../components/pet-view.slint";
import { Clock } from "../../components/clock.slint";
import { ChargingIndicator } from "../../components/charging-indicator.slint";

export component SystemWideSlot inherits Rectangle {
    out property <bool> is-hovered: false;

    property <length> margin-x: max(12px, min(24px, ThemeMetrics.wide-width * 0.04));
    property <length> content-h: ThemeMetrics.wide-height * 0.86;

    width: 100%;
    height: 100%;

    // Row: Pet | Clock & Date | Battery
    HorizontalLayout {
        x: root.margin-x;
        y: (root.height - self.height) / 2;
        width: root.width - (root.margin-x * 2);
        height: root.content-h;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            PetView {
                pet-size: root.content-h;
            }
        }

        VerticalLayout {
            alignment: center;
            Clock {
                time-str: IslandContext.time-str;
                date-str: IslandContext.date-str;
                show-date: root.content-h >= 28px;
                font-size: max(11px, min(16px, root.content-h * 0.38));
            }
        }

        VerticalLayout {
            alignment: center;
            ChargingIndicator {
                percentage: IslandContext.battery-percentage;
                is-charging: IslandContext.is-charging;
                compact: false;
            }
        }
    }
}

