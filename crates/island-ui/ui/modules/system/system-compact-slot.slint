import { IslandContext } from "../../context.slint";
import { PetView } from "../../components/pet-view.slint";
import { Clock } from "../../components/clock.slint";
import { ChargingIndicator } from "../../components/charging-indicator.slint";

export component SystemCompactSlot inherits HorizontalLayout {
    width: 100%;
    height: 100%;
    padding-left: 10px;
    padding-right: 12px;
    alignment: space-between;

    // Left: 3D Pet
    VerticalLayout {
        alignment: center;
        PetView {
            pet-size: 30px;
        }
    }

    // Center: Digital Clock
    VerticalLayout {
        alignment: center;
        Clock {
            time-str: IslandContext.time-str;
            show-date: false;
            font-size: max(10px, min(14px, parent.height * 0.42));
        }
    }

    // Right: Battery & Charging Status (with green ring + bolt when charging)
    VerticalLayout {
        alignment: center;
        ChargingIndicator {
            percentage: IslandContext.battery-percentage;
            is-charging: IslandContext.is-charging;
            compact: true;
        }
    }
}
