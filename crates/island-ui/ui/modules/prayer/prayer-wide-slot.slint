import { ThemeColors } from "../../theme/colors.slint";
import { ThemeMetrics } from "../../theme/metrics.slint";
import { ThemeTypography } from "../../theme/typography.slint";
import { Icons } from "../../theme/icons.slint";
import { IslandContext } from "../../context.slint";

export component PrayerWideSlot inherits Rectangle {
    out property <bool> is-hovered: false;

    property <length> margin-x: max(12px, min(24px, ThemeMetrics.wide-width * 0.04));
    property <length> content-h: ThemeMetrics.wide-height * 0.82;
    property <string> city-label: IslandContext.prayer-city-labels[IslandContext.prayer-city-index];

    width: 100%;
    height: 100%;

    HorizontalLayout {
        x: root.margin-x;
        y: (root.height - self.height) / 2;
        width: root.width - (root.margin-x * 2);
        height: root.content-h;
        alignment: space-between;
        spacing: 8px;

        HorizontalLayout {
            alignment: start;
            spacing: 8px;

            Rectangle {
                width: root.content-h * 0.52;
                height: root.content-h * 0.52;
                border-radius: self.width / 2;
                background: #5aa2ff1c;

                Image {
                    width: 58%;
                    height: 58%;
                    source: Icons.moon;
                    colorize: ThemeColors.accent;
                    image-fit: contain;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 0px;

                Text {
                    text: IslandContext.prayer-next-name != "" ? IslandContext.prayer-next-name : "Jadwal sholat";
                    color: ThemeColors.foreground;
                    font-family: ThemeTypography.font-family;
                    font-size: max(11px, min(14px, root.content-h * 0.27));
                    font-weight: ThemeTypography.weight-bold;
                    vertical-alignment: center;
                }

                Text {
                    text: IslandContext.prayer-next-time != ""
                        ? "Berikutnya · " + IslandContext.prayer-next-time
                        : "Belum ada jadwal";
                    color: ThemeColors.muted;
                    font-family: ThemeTypography.font-family;
                    font-size: max(8px, min(10px, root.content-h * 0.18));
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 0px;

            Text {
                text: IslandContext.prayer-now-time;
                color: ThemeColors.foreground;
                font-family: ThemeTypography.font-family;
                font-size: max(14px, min(19px, root.content-h * 0.36));
                font-weight: ThemeTypography.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            Text {
                text: "waktu kota";
                color: ThemeColors.subtle;
                font-family: ThemeTypography.font-family;
                font-size: max(7px, min(9px, root.content-h * 0.16));
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: IslandContext.prayer-countdown;
                color: ThemeColors.warning;
                font-family: ThemeTypography.font-family;
                font-size: max(10px, min(13px, root.content-h * 0.24));
                font-weight: ThemeTypography.weight-bold;
                horizontal-alignment: right;
            }

            Text {
                text: root.city-label;
                color: ThemeColors.muted;
                font-family: ThemeTypography.font-family;
                font-size: max(8px, min(10px, root.content-h * 0.18));
                horizontal-alignment: right;
                overflow: elide;
            }
        }
    }
}
