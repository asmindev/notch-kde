import { ThemeColors } from "../../theme/colors.slint";
import { ThemeTypography } from "../../theme/typography.slint";
import { Icons } from "../../theme/icons.slint";
import { IslandContext } from "../../context.slint";
import { ThemeMetrics } from "../../theme/metrics.slint";
import { PetView } from "../../components/pet-view.slint";

export component AlertCompactSlot inherits HorizontalLayout {
    width: 100%;
    height: 100%;
    property <length> pad-x: max(8px, min(16px, ThemeMetrics.compact-width * 0.06));
    padding-left: root.pad-x;
    padding-right: root.pad-x;
    alignment: space-between;

    property <length> badge-outer: max(18px, min(24px, ThemeMetrics.compact-height - 6px));
    property <length> badge-inner: max(14px, min(20px, root.badge-outer - 4px));
    property <length> icon-dim: max(8px, min(12px, root.badge-inner * 0.55));
    property <length> font-sz: max(9px, min(13px, ThemeMetrics.compact-height * 0.36));
    property <bool> pulse: true;

    pulse-timer := Timer {
        interval: 850ms;
        running: IslandContext.alert-kind == 1;
        triggered => { root.pulse = !root.pulse; }
    }

    // Left: Glowing Animated Lightning Badge
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: root.badge-outer;
            height: root.badge-outer;
            border-radius: root.badge-outer / 2;
            background: #22c55e26; // Soft neon-green halo aura

            Rectangle {
                width: 100%;
                height: 100%;
                border-radius: self.width / 2;
                background: #22c55e;
                opacity: root.pulse ? 0.22 : 0.06;
                animate opacity { duration: 700ms; easing: ease-in-out; }
            }

            if IslandContext.alert-kind == 1: PetView {
                x: (root.badge-outer - self.width) / 2;
                y: (root.badge-outer - self.height) / 2;
                width: root.badge-outer;
                height: root.badge-outer;
                pet-size: root.badge-outer;
            }

            if IslandContext.alert-kind != 1: Rectangle {
                x: (root.badge-outer - root.badge-inner) / 2;
                y: (root.badge-outer - root.badge-inner) / 2;
                width: root.badge-inner;
                height: root.badge-inner;
                border-radius: root.badge-inner / 2;
                background: #172a1e;
                border-width: 1.5px;
                border-color: ThemeColors.success;

                Image {
                    width: root.icon-dim;
                    height: root.icon-dim;
                    source: Icons.zap;
                    image-fit: contain;
                    colorize: ThemeColors.success;
                }
            }
        }
    }

    // Center: Alert Message with smooth typography
    VerticalLayout {
        alignment: center;
        Text {
            text: IslandContext.alert-kind == 1 ? "Charging..." : "System Alert";
            color: ThemeColors.foreground;
            font-family: ThemeTypography.font-family;
            font-size: root.font-sz;
            font-weight: ThemeTypography.weight-medium;
            vertical-alignment: center;
        }
    }

    // Right: Vivid Value (Percentage)
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            padding-left: 6px;
            padding-right: 6px;
            padding-top: 2px;
            padding-bottom: 2px;

            Text {
                text: "\{IslandContext.battery-percentage}%";
                color: ThemeColors.success;
                font-family: ThemeTypography.font-family;
                font-size: root.font-sz;
                font-weight: ThemeTypography.weight-bold;
                vertical-alignment: center;
            }
        }
    }
}
