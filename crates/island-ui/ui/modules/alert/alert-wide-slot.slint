import { ThemeColors } from "../../theme/colors.slint";
import { ThemeTypography } from "../../theme/typography.slint";
import { Icons } from "../../theme/icons.slint";
import { ThemeMetrics } from "../../theme/metrics.slint";

export component AlertWideSlot inherits Rectangle {
    in property <string> alert-title: "Notification";
    in property <string> alert-message: "System Alert";
    in property <image> alert-icon: Icons.zap;

    width: 100%;
    height: 100%;

    property <length> icon-dim: max(18px, min(28px, ThemeMetrics.wide-height * 0.55));
    property <length> margin-x: max(12px, min(24px, ThemeMetrics.wide-width * 0.04));

    HorizontalLayout {
        padding-left: root.margin-x;
        padding-right: root.margin-x;
        spacing: 12px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Image {
                width: root.icon-dim;
                height: root.icon-dim;
                source: root.alert-icon;
                image-fit: contain;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.alert-title;
                color: ThemeColors.foreground;
                font-family: ThemeTypography.font-family;
                font-size: max(11px, min(15px, ThemeMetrics.wide-height * 0.32));
                font-weight: ThemeTypography.weight-bold;
            }

            Text {
                text: root.alert-message;
                color: ThemeColors.muted;
                font-family: ThemeTypography.font-family;
                font-size: max(9px, min(12px, ThemeMetrics.wide-height * 0.24));
            }
        }
    }
}
