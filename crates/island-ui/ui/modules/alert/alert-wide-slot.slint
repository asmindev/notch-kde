import { ThemeColors } from "../../theme/colors.slint";
import { ThemeTypography } from "../../theme/typography.slint";
import { Icons } from "../../theme/icons.slint";
import { ThemeMetrics } from "../../theme/metrics.slint";
import { IslandContext } from "../../context.slint";
import { PetView } from "../../components/pet-view.slint";

export component AlertWideSlot inherits Rectangle {
    in property <bool> active: true;
    property <bool> is-charging-alert: IslandContext.alert-kind == 1;
    property <bool> is-prayer-alert: IslandContext.alert-kind == 3;
    in property <string> alert-title: root.is-prayer-alert ? IslandContext.prayer-title
        : (root.is-charging-alert ? "Charger connected" : "Notification");
    in property <string> alert-message: root.is-prayer-alert
        ? IslandContext.prayer-time + " • " + IslandContext.prayer-city-label
        : (root.is-charging-alert ? "Battery \{IslandContext.battery-percentage}% • Charging" : "System Alert");
    in property <image> alert-icon: root.is-prayer-alert ? Icons.moon : Icons.zap;

    width: 100%;
    height: 100%;

    property <length> icon-dim: max(18px, min(28px, ThemeMetrics.wide-height * 0.55));
    property <length> pet-dim: max(30px, min(44px, ThemeMetrics.wide-height * 0.78));
    property <length> margin-x: max(12px, min(24px, ThemeMetrics.wide-width * 0.04));

    HorizontalLayout {
        padding-left: root.margin-x;
        padding-right: root.margin-x;
        spacing: 12px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            if root.is-charging-alert: PetView {
                active: root.active;
                width: root.pet-dim;
                height: root.pet-dim;
                pet-size: root.pet-dim;
            }
            if !root.is-charging-alert: Image {
                width: root.icon-dim;
                height: root.icon-dim;
                source: root.alert-icon;
                image-fit: contain;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.alert-title;
                color: root.is-prayer-alert ? ThemeColors.accent
                    : (root.is-charging-alert ? ThemeColors.success : ThemeColors.foreground);
                font-family: ThemeTypography.font-family;
                font-size: max(11px, min(15px, ThemeMetrics.wide-height * 0.32));
                font-weight: ThemeTypography.weight-bold;
            }

            Text {
                text: root.alert-message;
                color: ThemeColors.muted;
                font-family: ThemeTypography.font-family;
                font-size: max(9px, min(12px, ThemeMetrics.wide-height * 0.24));
            }
        }
    }
}
