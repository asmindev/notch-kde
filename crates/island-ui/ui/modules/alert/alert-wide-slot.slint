import { ThemeColors } from "../../theme/colors.slint";
import { ThemeTypography } from "../../theme/typography.slint";

export component AlertWideSlot inherits Rectangle {
    in property <string> alert-title: "Notification";
    in property <string> alert-message: "System Alert";
    in property <image> alert-icon: @image-url("../../../assets/icons/zap.svg");

    width: 100%;
    height: 100%;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Image {
                width: 22px;
                height: 22px;
                source: root.alert-icon;
                image-fit: contain;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.alert-title;
                color: ThemeColors.foreground;
                font-family: ThemeTypography.font-family;
                font-size: ThemeTypography.size-sm;
                font-weight: ThemeTypography.weight-bold;
            }

            Text {
                text: root.alert-message;
                color: ThemeColors.muted;
                font-family: ThemeTypography.font-family;
                font-size: ThemeTypography.size-xs;
            }
        }
    }
}
