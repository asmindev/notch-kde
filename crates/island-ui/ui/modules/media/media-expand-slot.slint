import { ThemeColors } from "../../theme/colors.slint";
import { ThemeMetrics } from "../../theme/metrics.slint";
import { ThemeTypography } from "../../theme/typography.slint";
import { IslandContext } from "../../context.slint";
import { PetView } from "../../components/pet-view.slint";
import { AlbumArt } from "../../components/album-art.slint";
import { PlaybackControls } from "../../components/playback-controls.slint";
import { CavaVisualizer } from "../../components/cava-visualizer.slint";

export component MediaExpandSlot inherits Rectangle {
    out property <bool> is-hovered: controls.is-hovered || art-touch.has-hover;

    // Available slot height inside expand container (excluding header and paddings)
    property <length> slot-h: max(40px, ThemeMetrics.expand-height - 44px);
    property <length> art-dim: max(36px, min(80px, root.slot-h * 0.8));
    property <bool> show-pet: IslandContext.music-visual-mode == 1;

    width: 100%;
    height: 100%;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        alignment: space-between;

        // LEFT GROUP: [Art Cover] + [Title | Artist | Visualizer tepat di bawah artist]
        HorizontalLayout {
            alignment: start;
            spacing: max(10px, min(18px, ThemeMetrics.expand-width * 0.03));
            horizontal-stretch: 1;

            // 1. Art Cover (Dynamically sized to art-dim, flips with Pet)
            VerticalLayout {
                alignment: center;
                art-container := Rectangle {
                    width: root.art-dim;
                    height: root.art-dim;
                    border-radius: root.show-pet ? 0px : root.art-dim * 0.2;
                    background: root.show-pet ? transparent : #141418;
                    border-width: root.show-pet ? 0px : 1px;
                    border-color: root.show-pet ? transparent : #27272a;
                    clip: !root.show-pet;

                    // Mode 0: Album Art Cover (Default)
                    if IslandContext.music-visual-mode == 0: AlbumArt {
                        art-size: root.art-dim;
                        art-source: IslandContext.art-image;
                        has-art: IslandContext.has-art;
                    }

                    // Mode 1: 3D Pet (Flipped)
                    if IslandContext.music-visual-mode == 1: VerticalLayout {
                        alignment: center;
                        PetView {
                            pet-size: root.art-dim;
                        }
                    }

                    art-touch := TouchArea {
                        clicked => { IslandContext.toggle-swap(); }
                    }
                }
            }

            // 2. Center: Title (atas) | Artist (bawah) | Visualizer tepat di bawah artist
            VerticalLayout {
                alignment: center;
                spacing: max(2px, min(6px, root.slot-h * 0.04));
                horizontal-stretch: 1;

                // Song Title
                Text {
                    text: IslandContext.song-title != "" ? IslandContext.song-title : "No Track";
                    color: ThemeColors.foreground;
                    font-family: ThemeTypography.font-family;
                    font-size: max(12px, min(17px, root.slot-h * 0.24));
                    font-weight: ThemeTypography.weight-bold;
                    overflow: elide;
                    wrap: no-wrap;
                    max-lines: 1;
                    vertical-alignment: center;
                }

                // Artist Name
                Text {
                    text: IslandContext.song-artist != "" ? IslandContext.song-artist : "Unknown Artist";
                    color: ThemeColors.muted;
                    font-family: ThemeTypography.font-family;
                    font-size: max(10px, min(13px, root.slot-h * 0.18));
                    font-weight: ThemeTypography.weight-medium;
                    overflow: elide;
                    wrap: no-wrap;
                    max-lines: 1;
                    vertical-alignment: center;
                }

                // Visualizer tepat di bawah artist!
                HorizontalLayout {
                    alignment: start;
                    padding-top: 2px;
                    height: max(10px, min(18px, root.slot-h * 0.22));

                    CavaVisualizer {
                        b0: IslandContext.b0;
                        b1: IslandContext.b1;
                        b2: IslandContext.b2;
                        b3: IslandContext.b3;
                        b4: IslandContext.b4;
                        b5: IslandContext.b5;
                        b6: IslandContext.b6;
                        b7: IslandContext.b7;
                        viz-height: max(10px, min(18px, root.slot-h * 0.22));
                    }
                }
            }
        }

        // 3. RIGHT: Playback Controls (Responsive to slot-h)
        VerticalLayout {
            alignment: center;
            controls := PlaybackControls {
                control-size: max(22px, min(34px, root.slot-h * 0.45));
                is-playing: IslandContext.is-playing;
                play-pause => { IslandContext.play-pause(); }
                next => { IslandContext.next-track(); }
                previous => { IslandContext.prev-track(); }
            }
        }
    }
}
