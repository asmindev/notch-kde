import { ThemeColors } from "../theme/colors.slint";
import { ThemeMetrics } from "../theme/metrics.slint";
import { IslandContext } from "../context.slint";
import { ConcaveCorner } from "concave-corner.slint";

export component IslandShell inherits Rectangle {
    in property <int> active-mode: 0; // 0=Compact, 1=Wide, 2=Expand
    in property <int> alert-kind: 0;
    in property <bool> is-expanded: false;
    in property <bool> is-visible-state: true;

    callback hover-changed(bool);
    callback island-clicked();
    out property <bool> has-hover <=> touch.has-hover;

    width: ThemeMetrics.window-width;
    height: ThemeMetrics.window-height;
    background: transparent;

    // Fluid spring morph targets based on 3-tier active view mode
    property <length> target-w: 
        !root.is-visible-state ? ThemeMetrics.compact-width :
        (root.active-mode == 2 ? ThemeMetrics.expand-width :
        (root.active-mode == 1 ? ThemeMetrics.wide-width :
        (root.alert-kind != 0 ? ThemeMetrics.compact-alert-width :
        ThemeMetrics.compact-width)));

    property <length> target-h: 
        !root.is-visible-state ? ThemeMetrics.compact-height :
        (root.active-mode == 2 ? (ThemeMetrics.expand-height + ThemeMetrics.bottom-bar-height) :
        (root.active-mode == 1 ? (IslandContext.is-welcome ? ThemeMetrics.welcome-height : (ThemeMetrics.wide-height + ThemeMetrics.bottom-bar-height)) :
        ThemeMetrics.compact-height));

    property <length> target-r:
        root.active-mode == 2 ? ThemeMetrics.expand-radius :
        (root.active-mode == 1 ? (IslandContext.is-welcome ? ThemeMetrics.welcome-radius : ThemeMetrics.wide-radius) :
        ThemeMetrics.compact-radius);

    // Dynamic Concave Ear Size: 5px in Compact, 10px in Wide & Expand
    property <length> current-ear-size: root.active-mode == 0 
        ? ThemeMetrics.compact-ear-size 
        : ThemeMetrics.wide-ear-size;

    animate current-ear-size {
        duration: root.is-expanded ? 340ms : 220ms;
        easing: cubic-bezier(0.34, 1.25, 0.64, 1.0);
    }

    // 1. Touch and Hover Area (Background layer - handles hover and background clicks)
    touch := TouchArea {
        x: notch.x - root.current-ear-size;
        y: 0px;
        width: notch.width + (root.current-ear-size * 2);
        height: root.is-visible-state ? notch.height + 12px : 28px;

        changed has-hover => {
            root.hover-changed(self.has-hover);
            IslandContext.look-active = self.has-hover;
            if (!self.has-hover) {
                IslandContext.look-x = 0.0;
                IslandContext.look-y = 0.0;
                IslandContext.cursor-moved(0.0, 0.0);
            }
        }

        changed mouse-x => {
            if (self.has-hover && self.width > 0px && self.height > 0px) {
                IslandContext.look-x = max(-1.0, min(1.0, (self.mouse-x / self.width) * 2.0 - 1.0));
                IslandContext.look-y = max(-1.0, min(1.0, (self.mouse-y / self.height) * 2.0 - 1.0));
                IslandContext.cursor-moved(IslandContext.look-x, IslandContext.look-y);
            }
        }

        changed mouse-y => {
            if (self.has-hover && self.width > 0px && self.height > 0px) {
                IslandContext.look-x = max(-1.0, min(1.0, (self.mouse-x / self.width) * 2.0 - 1.0));
                IslandContext.look-y = max(-1.0, min(1.0, (self.mouse-y / self.height) * 2.0 - 1.0));
                IslandContext.cursor-moved(IslandContext.look-x, IslandContext.look-y);
            }
        }

        clicked => {
            root.island-clicked();
        }
    }

    // 2. Left Concave Ear (Curves into left wall of notch, layered behind notch)
    left-ear := ConcaveCorner {
        x: notch.x - root.current-ear-size;
        y: notch.y;
        width: root.current-ear-size;
        height: root.current-ear-size;
        opacity: root.is-visible-state ? 1.0 : 0.0;
        is-right: false;
        fill-color: ThemeColors.background;

        animate opacity {
            duration: 200ms;
            easing: ease-out;
        }
    }

    // 3. Right Concave Ear (Curves into right wall of notch, layered behind notch)
    right-ear := ConcaveCorner {
        x: notch.x + notch.width;
        y: notch.y;
        width: root.current-ear-size;
        height: root.current-ear-size;
        opacity: root.is-visible-state ? 1.0 : 0.0;
        is-right: true;
        fill-color: ThemeColors.background;

        animate opacity {
            duration: 200ms;
            easing: ease-out;
        }
    }

    // 4. Main visible notch pill (Renders on top of ears and touch area)
    notch := Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.is-visible-state ? 0px : -160px;
        width: root.target-w;
        height: root.target-h;
        background: ThemeColors.background;
        border-bottom-left-radius: root.target-r;
        border-bottom-right-radius: root.target-r;
        opacity: root.is-visible-state ? 1.0 : 0.0;

        // Spring / Gooey Morphing Animations
        animate width {
            duration: root.active-mode == 2 ? ThemeMetrics.expand-duration : ThemeMetrics.collapse-duration;
            easing: cubic-bezier(0.34, 1.25, 0.64, 1.0);
        }
        animate height {
            duration: root.active-mode == 2 ? ThemeMetrics.expand-duration : ThemeMetrics.collapse-duration;
            easing: cubic-bezier(0.34, 1.2, 0.64, 1.0);
        }
        animate border-bottom-left-radius {
            duration: root.active-mode == 2 ? 340ms : 220ms;
            easing: cubic-bezier(0.34, 1.25, 0.64, 1.0);
        }
        animate border-bottom-right-radius {
            duration: root.active-mode == 2 ? 340ms : 220ms;
            easing: cubic-bezier(0.34, 1.25, 0.64, 1.0);
        }
        animate y {
            duration: root.is-visible-state ? 260ms : 200ms;
            easing: root.is-visible-state 
                ? cubic-bezier(0.16, 1.0, 0.3, 1.0) 
                : cubic-bezier(0.4, 0.0, 1.0, 1.0);
        }
        animate opacity {
            duration: 200ms;
            easing: ease-out;
        }

        // Inner content container (Hardware rectangular scissor clip strictly bounds children)
        content-box := Rectangle {
            width: 100%;
            height: 100%;
            clip: true;

            @children
        }
    }
}
