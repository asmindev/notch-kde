import { IslandContext } from "context.slint";
import { ScrollView } from "std-widgets.slint";
import { ThemeColors } from "theme/colors.slint";
import { ThemeTypography } from "theme/typography.slint";
import { PetView } from "components/pet-view.slint";
import {
    SettingsActionButton,
    SettingsCard,
    SettingsChip,
    SettingsDivider,
    SettingsNavItem,
    SettingsSegmentButton,
    SettingsSelect,
    SettingsSliderRow,
    SettingsSwatch,
    SettingsToggleRow,
} from "components/settings-controls.slint";

component SettingsPageHeader inherits VerticalLayout {
    in property <string> title: "";
    in property <string> subtitle: "";

    spacing: 2px;
    alignment: start;

    Text {
        text: root.title;
        color: ThemeColors.foreground;
        font-family: ThemeTypography.font-family;
        font-size: ThemeTypography.size-xl;
        font-weight: ThemeTypography.weight-bold;
    }

    Text {
        text: root.subtitle;
        color: ThemeColors.subtle;
        font-family: ThemeTypography.font-family;
        font-size: ThemeTypography.size-sm;
    }
}

component AvatarSettingsPage inherits Rectangle {
    HorizontalLayout {
        spacing: 16px;
        alignment: start;

        VerticalLayout {
            width: 270px;
            spacing: 10px;

            SettingsCard {
                title: "Bentuk";
                description: "Siluet dasar Bloub.";

                HorizontalLayout {
                    spacing: 5px;
                    alignment: start;

                    for shape in IslandContext.avatar-shapes: SettingsChip {
                        glyph: shape.glyph;
                        active: IslandContext.blob-character == shape.index;
                        clicked => { IslandContext.select-blob-character(shape.index); }
                    }
                }
            }

            SettingsCard {
                title: "Warna";
                description: "Palet warna tubuh dan aksen.";

                GridLayout {
                    spacing: 7px;

                    Row {
                        for i in 7: SettingsSwatch {
                            swatch: IslandContext.avatar-palettes[i].swatch;
                            active: IslandContext.blob-palette == IslandContext.avatar-palettes[i].index;
                            clicked => { IslandContext.select-blob-palette(IslandContext.avatar-palettes[i].index); }
                        }
                    }

                    Row {
                        for i in 7: SettingsSwatch {
                            swatch: IslandContext.avatar-palettes[i + 7].swatch;
                            active: IslandContext.blob-palette == IslandContext.avatar-palettes[i + 7].index;
                            clicked => { IslandContext.select-blob-palette(IslandContext.avatar-palettes[i + 7].index); }
                        }
                    }
                }
            }

            SettingsCard {
                title: "Ekspresi";
                description: "Ekspresi manual menimpa reaksi otomatis.";

                GridLayout {
                    spacing: 5px;

                    Row {
                        for i in 6: SettingsChip {
                            glyph: IslandContext.avatar-expressions[i].glyph;
                            active: IslandContext.blob-expression == IslandContext.avatar-expressions[i].index;
                            clicked => { IslandContext.select-blob-expression(IslandContext.avatar-expressions[i].index); }
                        }
                    }

                    Row {
                        for i in 6: SettingsChip {
                            glyph: IslandContext.avatar-expressions[i + 6].glyph;
                            active: IslandContext.blob-expression == IslandContext.avatar-expressions[i + 6].index;
                            clicked => { IslandContext.select-blob-expression(IslandContext.avatar-expressions[i + 6].index); }
                        }
                    }

                    Row {
                        for i in 5: SettingsChip {
                            glyph: IslandContext.avatar-expressions[i + 12].glyph;
                            active: IslandContext.blob-expression == IslandContext.avatar-expressions[i + 12].index;
                            clicked => { IslandContext.select-blob-expression(IslandContext.avatar-expressions[i + 12].index); }
                        }
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 100%;
            border-radius: 14px;
            background: #101014;
            border-width: 1px;
            border-color: ThemeColors.border;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                alignment: center;

                Text {
                    text: "Pratinjau langsung";
                    color: ThemeColors.subtle;
                    font-family: ThemeTypography.font-family;
                    font-size: ThemeTypography.size-xs;
                    font-weight: ThemeTypography.weight-bold;
                    horizontal-alignment: center;
                }

                PetView {
                    pet-size: 144px;
                }

                Text {
                    text: IslandContext.avatar-shapes[IslandContext.blob-character].label
                        + " · " + IslandContext.avatar-palettes[IslandContext.blob-palette].label
                        + " · " + IslandContext.avatar-expressions[IslandContext.blob-expression].label;
                    color: ThemeColors.muted;
                    font-family: ThemeTypography.font-family;
                    font-size: ThemeTypography.size-xs;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    SettingsActionButton {
                        label: "Acak";
                        compact: true;
                        clicked => { IslandContext.randomize-avatar(); }
                    }

                    SettingsActionButton {
                        label: IslandContext.avatar-random ? "Auto ✓" : "Auto";
                        compact: true;
                        clicked => { IslandContext.toggle-avatar-random(); }
                    }
                }

                Text {
                    text: "Klik Bloub untuk mencoba reaksi";
                    color: ThemeColors.subtle;
                    font-family: ThemeTypography.font-family;
                    font-size: ThemeTypography.size-xs;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}

component BehaviorSettingsPage inherits Rectangle {
    SettingsCard {
        title: "Interaksi Bloub";
        description: "Atur kapan Bloub bereaksi terhadap sekitar.";

        SettingsToggleRow {
            title: "Mengikuti kursor";
            subtitle: "Mata mengikuti gerakan kursor di sekitar island.";
            checked: IslandContext.cursor-gaze-enabled;
            toggled(value) => { IslandContext.set-cursor-gaze(value); }
        }

        SettingsDivider {}

        SettingsToggleRow {
            title: "Akting saat diam";
            subtitle: "Bloub melakukan gerakan kecil ketika sedang santai.";
            checked: IslandContext.idle-acting-enabled;
            toggled(value) => { IslandContext.set-idle-acting(value); }
        }

        SettingsDivider {}

        SettingsToggleRow {
            title: "Reaksi klik";
            subtitle: "Melompat, senang, atau pusing saat Bloub diklik.";
            checked: IslandContext.click-stunts-enabled;
            toggled(value) => { IslandContext.set-click-stunts(value); }
        }

        SettingsDivider {}

        SettingsToggleRow {
            title: "Reaksi notifikasi";
            subtitle: "Bloub menoleh saat notifikasi masuk.";
            checked: IslandContext.notification-reactions-enabled;
            toggled(value) => { IslandContext.set-notification-reactions(value); }
        }

        SettingsDivider {}

        SettingsToggleRow {
            title: "Reaksi musik";
            subtitle: "Bloub ikut bernyanyi dan bergerak saat musik diputar.";
            checked: IslandContext.music-reactions-enabled;
            toggled(value) => { IslandContext.set-music-reactions(value); }
        }

        SettingsDivider {}

        SettingsToggleRow {
            title: "Mengantuk saat baterai lemah";
            subtitle: "Bloub terlihat mengantuk ketika baterai di bawah 20%.";
            checked: IslandContext.sleepy-on-low-battery;
            toggled(value) => { IslandContext.set-sleepy-on-low-battery(value); }
        }
    }
}

component PrayerScheduleRow inherits Rectangle {
    in property <string> name: "";
    in property <string> time: "";
    in property <bool> is-next: false;

    height: 32px;
    border-radius: 8px;
    background: root.is-next ? #5aa2ff18 : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: space-between;

        Text {
            text: root.name;
            color: root.is-next ? ThemeColors.foreground : ThemeColors.muted;
            font-family: ThemeTypography.font-family;
            font-size: ThemeTypography.size-sm;
            font-weight: root.is-next ? ThemeTypography.weight-bold : ThemeTypography.weight-medium;
            vertical-alignment: center;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;

            Text {
                text: root.is-next ? "Berikutnya" : "";
                color: ThemeColors.accent;
                font-family: ThemeTypography.font-family;
                font-size: ThemeTypography.size-xs;
                font-weight: ThemeTypography.weight-bold;
                vertical-alignment: center;
            }

            Text {
                text: root.time;
                color: root.is-next ? ThemeColors.foreground : ThemeColors.muted;
                font-family: ThemeTypography.font-family;
                font-size: ThemeTypography.size-sm;
                font-weight: ThemeTypography.weight-bold;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }
    }
}

component PrayerSettingsPage inherits Rectangle {
    ScrollView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        mouse-drag-pan-enabled: true;

        VerticalLayout {
            width: 100%;
            spacing: 10px;
            alignment: start;

            SettingsCard {
                title: "Notifikasi sholat";
                description: "Tampilkan pengingat waktu sholat di notch.";

                SettingsToggleRow {
                    title: "Aktifkan";
                    subtitle: "Notifikasi masuk saat waktu sholat dan sebelum waktunya.";
                    checked: IslandContext.prayer-enabled;
                    toggled(value) => { IslandContext.set-prayer-enabled(value); }
                }

                SettingsDivider {}

                HorizontalLayout {
                    spacing: 12px;
                    alignment: space-between;

                    Text {
                        text: "Kota";
                        color: ThemeColors.foreground;
                        font-family: ThemeTypography.font-family;
                        font-size: ThemeTypography.size-sm;
                        font-weight: ThemeTypography.weight-bold;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    SettingsSelect {
                        width: 250px;
                        model: IslandContext.prayer-city-labels;
                        current-index: IslandContext.prayer-city-index;
                        selected(index) => { IslandContext.set-prayer-city(index); }
                    }
                }
            }

            SettingsCard {
                title: "Jadwal sholat";
                description: IslandContext.prayer-schedule-subtitle;

                if IslandContext.prayer-schedule.length == 0: Text {
                    text: "Jadwal tidak tersedia untuk tanggal ini.";
                    color: ThemeColors.subtle;
                    font-family: ThemeTypography.font-family;
                    font-size: ThemeTypography.size-sm;
                }

                VerticalLayout {
                    spacing: 2px;

                    for item in IslandContext.prayer-schedule : PrayerScheduleRow {
                        name: item.name;
                        time: item.time;
                        is-next: item.is-next;
                    }
                }
            }

            SettingsCard {
                title: "Pengingat";
                description: "Notifikasi tambahan sebelum waktu sholat.";

                HorizontalLayout {
                    spacing: 5px;
                    alignment: start;

                    SettingsSegmentButton {
                        label: "Off";
                        active: IslandContext.prayer-reminder-minutes == 0;
                        clicked => { IslandContext.set-prayer-reminder-minutes(0); }
                    }

                    SettingsSegmentButton {
                        label: "5 mnt";
                        active: IslandContext.prayer-reminder-minutes == 5;
                        clicked => { IslandContext.set-prayer-reminder-minutes(5); }
                    }

                    SettingsSegmentButton {
                        label: "10 mnt";
                        active: IslandContext.prayer-reminder-minutes == 10;
                        clicked => { IslandContext.set-prayer-reminder-minutes(10); }
                    }

                    SettingsSegmentButton {
                        label: "15 mnt";
                        active: IslandContext.prayer-reminder-minutes == 15;
                        clicked => { IslandContext.set-prayer-reminder-minutes(15); }
                    }
                }
            }

            Text {
                text: "Metode Kemenag: Subuh 20°, Isya 18°, Asr Syafi'i, ihtiyati +2 menit.";
                color: ThemeColors.subtle;
                font-family: ThemeTypography.font-family;
                font-size: ThemeTypography.size-xs;
                wrap: word-wrap;
            }
        }
    }
}

component SystemSettingsPage inherits Rectangle {
    ScrollView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        mouse-drag-pan-enabled: true;

        VerticalLayout {
            width: 100%;
            spacing: 10px;
            alignment: start;

            SettingsCard {
                title: "Bayangan notch";
                description: "Atur efek shadow lembut di sekitar notch.";

                SettingsToggleRow {
                    title: "Aktifkan shadow";
                    subtitle: "Matikan untuk tampilan notch tanpa bayangan.";
                    checked: IslandContext.shadow-enabled;
                    toggled(value) => { IslandContext.set-shadow-enabled(value); }
                }

                SettingsDivider {}

                SettingsSliderRow {
                    title: "Intensitas";
                    value: IslandContext.shadow-intensity;
                    minimum: 0;
                    maximum: 100;
                    suffix: "%";
                    changed(value) => { IslandContext.set-shadow-intensity(value); }
                }

                SettingsDivider {}

                SettingsSliderRow {
                    title: "Radius";
                    value: IslandContext.shadow-radius;
                    minimum: 0;
                    maximum: 48;
                    suffix: " px";
                    changed(value) => { IslandContext.set-shadow-radius(value); }
                }

                SettingsDivider {}

                SettingsSliderRow {
                    title: "Offset X";
                    value: IslandContext.shadow-offset-x;
                    minimum: -24;
                    maximum: 24;
                    suffix: " px";
                    signed: true;
                    changed(value) => { IslandContext.set-shadow-offset-x(value); }
                }

                SettingsDivider {}

                SettingsSliderRow {
                    title: "Offset Y";
                    value: IslandContext.shadow-offset-y;
                    minimum: -24;
                    maximum: 24;
                    suffix: " px";
                    signed: true;
                    changed(value) => { IslandContext.set-shadow-offset-y(value); }
                }
            }

            SettingsCard {
                title: "Renderer Bloub";
                description: "Pilih tampilan pet. Perubahan berlaku setelah restart.";

                Rectangle {
                    height: 32px;
                    border-radius: 9px;
                    background: #0f0f12;
                    border-width: 1px;
                    border-color: ThemeColors.divider;

                    HorizontalLayout {
                        spacing: 4px;
                        padding: 3px;
                        alignment: start;

                        SettingsSegmentButton {
                            label: "3D";
                            active: IslandContext.pet-renderer == 0;
                            clicked => { IslandContext.set-pet-renderer(0); }
                        }

                        SettingsSegmentButton {
                            label: "2D";
                            active: IslandContext.pet-renderer == 1;
                            clicked => { IslandContext.set-pet-renderer(1); }
                        }
                    }
                }

                Text {
                    text: "2D lebih ringan dan tidak memuat Vulkan saat aplikasi dimulai.";
                    color: ThemeColors.subtle;
                    font-family: ThemeTypography.font-family;
                    font-size: ThemeTypography.size-xs;
                    wrap: word-wrap;
                }
            }

            SettingsCard {
                title: "Mode compact";
                description: "Pilih elemen yang tampil saat island berada dalam mode compact.";

                Rectangle {
                    height: 32px;
                    border-radius: 9px;
                    background: #0f0f12;
                    border-width: 1px;
                    border-color: ThemeColors.divider;

                    HorizontalLayout {
                        spacing: 4px;
                        padding: 3px;
                        alignment: start;

                        SettingsSegmentButton {
                            label: "Lengkap";
                            active: IslandContext.compact-mode-style == 0;
                            clicked => { IslandContext.set-compact-mode-style(0); }
                        }

                        SettingsSegmentButton {
                            label: "Hanya Mata";
                            active: IslandContext.compact-mode-style == 1;
                            clicked => { IslandContext.set-compact-mode-style(1); }
                        }
                    }
                }

                Text {
                    text: IslandContext.compact-mode-style == 0
                        ? "Lengkap: menampilkan pet, jam digital, dan status baterai/CAVA."
                        : "Hanya Mata: menampilkan sepasang mata animasi di tengah notch.";
                    color: ThemeColors.subtle;
                    font-family: ThemeTypography.font-family;
                    font-size: ThemeTypography.size-xs;
                    wrap: word-wrap;
                }
            }

            SettingsCard {
                title: "Tampilan media";
                description: "Pilih fokus utama saat musik diputar.";

                Rectangle {
                    height: 32px;
                    border-radius: 9px;
                    background: #0f0f12;
                    border-width: 1px;
                    border-color: ThemeColors.divider;

                    HorizontalLayout {
                        spacing: 4px;
                        padding: 3px;
                        alignment: start;

                        SettingsSegmentButton {
                            label: "Artwork";
                            active: IslandContext.music-visual-mode == 0;
                            clicked => { IslandContext.set-media-visual-mode(0); }
                        }

                        SettingsSegmentButton {
                            label: "Bloub";
                            active: IslandContext.music-visual-mode == 1;
                            clicked => { IslandContext.set-media-visual-mode(1); }
                        }
                    }
                }
            }

            SettingsCard {
                title: "Notifikasi";
                description: "Pemantau notifikasi desktop.";

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: ThemeColors.success;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: "Aktif · Bloub akan menoleh saat notifikasi masuk";
                        color: ThemeColors.muted;
                        font-family: ThemeTypography.font-family;
                        font-size: ThemeTypography.size-sm;
                        vertical-alignment: center;
                    }
                }
            }

            SettingsCard {
                title: "Reset";
                description: "Kembalikan pengaturan ke kondisi awal.";

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    SettingsActionButton {
                        label: "Reset avatar";
                        clicked => { IslandContext.reset-avatar(); }
                    }

                    SettingsActionButton {
                        label: "Reset semua";
                        clicked => { IslandContext.reset-settings(); }
                    }
                }
            }
        }
    }
}

component AboutSettingsPage inherits Rectangle {
    VerticalLayout {
        height: 100%;
        alignment: start;

        SettingsCard {
            width: 100%;
            title: "notchde";
            description: "Dynamic island untuk KDE Plasma.";

            VerticalLayout {
                spacing: 8px;
                padding-top: 6px;

                Text {
                    text: "Versi " + IslandContext.app-version;
                    color: ThemeColors.muted;
                    font-family: ThemeTypography.font-family;
                    font-size: ThemeTypography.size-sm;
                }

                SettingsDivider {}

                Text {
                    text: "Bloub";
                    color: ThemeColors.foreground;
                    font-family: ThemeTypography.font-family;
                    font-size: ThemeTypography.size-base;
                    font-weight: ThemeTypography.weight-bold;
                }

                Text {
                    text: "Maskot prosedural oleh Bloub, dilisensikan di bawah MIT.";
                    color: ThemeColors.subtle;
                    font-family: ThemeTypography.font-family;
                    font-size: ThemeTypography.size-sm;
                    wrap: word-wrap;
                }

                Text {
                    text: "Dibuat dengan Slint, Rust, dan KDE Plasma.";
                    color: ThemeColors.subtle;
                    font-family: ThemeTypography.font-family;
                    font-size: ThemeTypography.size-sm;
                }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "Pengaturan notchde";
    width: 720px;
    height: 520px;
    background: ThemeColors.background;

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;

        Rectangle {
            width: 184px;
            height: 100%;
            background: #101013;
            border-width: 1px;
            border-color: #1c1c20;

            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 20px;
                padding-bottom: 20px;
                spacing: 5px;

                HorizontalLayout {
                    height: 44px;
                    spacing: 10px;
                    alignment: start;

                    Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 10px;
                        background: #5aa2ff22;
                        border-width: 1px;
                        border-color: #5aa2ff44;

                        Text {
                            text: "◒";
                            color: ThemeColors.accent;
                            font-size: 18px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        spacing: 1px;
                        alignment: center;

                        Text {
                            text: "notchde";
                            color: ThemeColors.foreground;
                            font-family: ThemeTypography.font-family;
                            font-size: ThemeTypography.size-base;
                            font-weight: ThemeTypography.weight-bold;
                        }

                        Text {
                            text: "Pengaturan";
                            color: ThemeColors.subtle;
                            font-family: ThemeTypography.font-family;
                            font-size: ThemeTypography.size-xs;
                        }
                    }
                }

                Rectangle {
                    height: 12px;
                    background: transparent;
                }

                SettingsNavItem {
                    label: "Avatar";
                    glyph: "◉";
                    active: IslandContext.settings-tab == 0;
                    clicked => { IslandContext.select-settings-tab(0); }
                }

                SettingsNavItem {
                    label: "Perilaku";
                    glyph: "✦";
                    active: IslandContext.settings-tab == 1;
                    clicked => { IslandContext.select-settings-tab(1); }
                }

                SettingsNavItem {
                    label: "Sholat";
                    glyph: "☾";
                    active: IslandContext.settings-tab == 2;
                    clicked => { IslandContext.select-settings-tab(2); }
                }

                SettingsNavItem {
                    label: "Sistem";
                    glyph: "⚙";
                    active: IslandContext.settings-tab == 3;
                    clicked => { IslandContext.select-settings-tab(3); }
                }

                SettingsNavItem {
                    label: "Tentang";
                    glyph: "ⓘ";
                    active: IslandContext.settings-tab == 4;
                    clicked => { IslandContext.select-settings-tab(4); }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                Text {
                    text: "v" + IslandContext.app-version;
                    color: ThemeColors.subtle;
                    font-family: ThemeTypography.font-family;
                    font-size: ThemeTypography.size-xs;
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            height: 100%;
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 20px;
            padding-bottom: 16px;
            spacing: 12px;

            HorizontalLayout {
                height: 42px;
                alignment: space-between;

                SettingsPageHeader {
                    title: IslandContext.settings-tab == 0 ? "Avatar"
                        : IslandContext.settings-tab == 1 ? "Perilaku"
                        : IslandContext.settings-tab == 2 ? "Sholat"
                        : IslandContext.settings-tab == 3 ? "Sistem"
                        : "Tentang";
                    subtitle: IslandContext.settings-tab == 0 ? "Sesuaikan penampilan Bloub."
                        : IslandContext.settings-tab == 1 ? "Atur cara Bloub bereaksi."
                        : IslandContext.settings-tab == 2 ? "Jadwal, notifikasi, dan pengingat waktu sholat."
                        : IslandContext.settings-tab == 3 ? "Preferensi tampilan dan reset."
                        : "Informasi aplikasi dan kredit.";
                }

                SettingsActionButton {
                    label: "Selesai";
                    primary: true;
                    clicked => { IslandContext.close-settings(); }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                background: transparent;

                if IslandContext.settings-tab == 0: AvatarSettingsPage {
                    width: 100%;
                    height: 100%;
                }

                if IslandContext.settings-tab == 1: BehaviorSettingsPage {
                    width: 100%;
                    height: 100%;
                }

                if IslandContext.settings-tab == 2: PrayerSettingsPage {
                    width: 100%;
                    height: 100%;
                }

                if IslandContext.settings-tab == 3: SystemSettingsPage {
                    width: 100%;
                    height: 100%;
                }

                if IslandContext.settings-tab == 4: AboutSettingsPage {
                    width: 100%;
                    height: 100%;
                }
            }

            HorizontalLayout {
                height: 30px;
                alignment: space-between;

                SettingsActionButton {
                    label: "Reset ke default";
                    compact: true;
                    clicked => { IslandContext.reset-settings(); }
                }

                Text {
                    text: "Perubahan tersimpan otomatis";
                    color: ThemeColors.subtle;
                    font-family: ThemeTypography.font-family;
                    font-size: ThemeTypography.size-xs;
                    vertical-alignment: center;
                }
            }
        }
    }
}
